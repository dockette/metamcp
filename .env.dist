DOCKER_PLATFORM=linux/amd64
DOCKER_WEB_IMAGE=dockette/metamcp:web
DOCKER_MIGRATOR_IMAGE=dockette/metamcp:migrator
DOCKER_HOSTING_IMAGE=dockette/metamcp:hosting

# Docker: metamcp
NODE_ENV=production
DATABASE_URL=postgresql://metamcp:metamcp@postgres:5432/metamcp
USE_DOCKER_HOST=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=metamcp

# Docker: postgres
POSTGRES_DB=metamcp
POSTGRES_USER=metamcp
POSTGRES_PASSWORD=metamcp

# Mcp: atlassian
MCP_ATLASSIAN_CONFLUENCE_URL=https://your-company.atlassian.net/wiki
MCP_ATLASSIAN_CONFLUENCE_USERNAME=yourusername
MCP_ATLASSIAN_CONFLUENCE_API_TOKEN=yourtoken
MCP_ATLASSIAN_JIRA_URL=https://your-company.atlassian.net
MCP_ATLASSIAN_JIRA_USERNAME=yourusername
MCP_ATLASSIAN_JIRA_API_TOKEN=yourtoken
MCP_ATLASSIAN_READ_ONLY_MODE=true
